{
  "common": {
    "name": "recorder",
    "version": "0.0.1",
    "news": {
      "0.0.1": {
        "en": "initial release",
        "de": "Erstveröffentlichung",
        "ru": "первоначальный выпуск",
        "pt": "lançamento inicial",
        "nl": "eerste release",
        "fr": "version initiale",
        "it": "rilascio iniziale",
        "es": "lanzamiento inicial",
        "pl": "pierwsze wydanie",
        "uk": "початковий випуск",
        "zh-cn": "首次发布"
      }
    },
    "titleLang": {
      "en": "Recorder",
      "de": "Recorder",
      "ru": "Рекордер",
      "pt": "Gravador",
      "nl": "Recorder",
      "fr": "Enregistreur",
      "it": "Registratore",
      "es": "Grabador",
      "pl": "Rejestrator",
      "uk": "Рекордер",
      "zh-cn": "记录器"
    },
    "desc": {
      "en": "Records all relevant states without per-state configuration: time travel, presence simulation and anomaly detection",
      "de": "Zeichnet alle relevanten Datenpunkte ohne Einzelkonfiguration auf: Zeitreise, Anwesenheitssimulation und Anomalieerkennung",
      "ru": "Записывает все важные состояния без настройки каждого из них: путешествие во времени, имитация присутствия и обнаружение аномалий",
      "pt": "Grava todos os estados relevantes sem configuração individual: viagem no tempo, simulação de presença e deteção de anomalias",
      "nl": "Registreert alle relevante datapunten zonder configuratie per datapunt: tijdreizen, aanwezigheidssimulatie en anomaliedetectie",
      "fr": "Enregistre tous les états pertinents sans configuration individuelle : voyage dans le temps, simulation de présence et détection d'anomalies",
      "it": "Registra tutti gli stati rilevanti senza configurazione individuale: viaggio nel tempo, simulazione di presenza e rilevamento di anomalie",
      "es": "Registra todos los estados relevantes sin configuración individual: viaje en el tiempo, simulación de presencia y detección de anomalías",
      "pl": "Rejestruje wszystkie istotne stany bez konfiguracji pojedynczych punktów: podróż w czasie, symulacja obecności i wykrywanie anomalii",
      "uk": "Записує всі важливі стани без налаштування кожного з них: подорож у часі, імітація присутності та виявлення аномалій",
      "zh-cn": "无需逐个配置即可记录所有相关状态：时间回溯、在家模拟和异常检测"
    },
    "authors": [
      "bluefox <dogafox@gmail.com>"
    ],
    "licenseInformation": {
      "license": "MIT",
      "type": "free"
    },
    "platform": "Javascript/Node.js",
    "mode": "daemon",
    "icon": "recorder.svg",
    "extIcon": "https://raw.githubusercontent.com/ioBroker/ioBroker.recorder/main/admin/recorder.svg",
    "readme": "https://github.com/ioBroker/ioBroker.recorder/blob/main/README.md",
    "keywords": [
      "recorder",
      "history",
      "time machine",
      "presence simulation",
      "anomaly detection"
    ],
    "loglevel": "info",
    "enabled": true,
    "compact": true,
    "nogit": true,
    "messagebox": true,
    "supportCustoms": true,
    "getHistory": true,
    "adminUI": {
      "config": "json",
      "custom": "json",
      "tab": "html"
    },
    "adminTab": {
      "singleton": false,
      "name": {
        "en": "Time machine",
        "de": "Zeitmaschine",
        "ru": "Машина времени",
        "pt": "Máquina do tempo",
        "nl": "Tijdmachine",
        "fr": "Machine à remonter le temps",
        "it": "Macchina del tempo",
        "es": "Máquina del tiempo",
        "pl": "Wehikuł czasu",
        "uk": "Машина часу",
        "zh-cn": "时光机"
      }
    },
    "type": "storage",
    "connectionType": "local",
    "dataSource": "push",
    "tier": 2,
    "dependencies": [
      {
        "js-controller": ">=6.0.11"
      }
    ],
    "globalDependencies": [
      {
        "admin": ">=7.0.0"
      }
    ]
  },
  "native": {
    "retentionDays": 30,
    "flushInterval": 30,
    "requireEnum": false,
    "catLight": "on",
    "catShading": "on",
    "catClimate": "on",
    "catWindows": "on",
    "catMotion": "off",
    "catSecurity": "on",
    "catSockets": "on",
    "catMedia": "on",
    "catWeather": "on",
    "catEnergy": "aggregated",
    "includePatterns": [],
    "excludePatterns": [],
    "highRate": 6,
    "burstLimit": 60,
    "roleRules": [],
    "mirrorStates": false,
    "simulation": false,
    "simTrigger": "",
    "simTriggerInvert": false,
    "simWeeks": 4,
    "simJitter": 15,
    "simSunset": true,
    "simMedia": false,
    "simScripts": false,
    "simDryRun": false,
    "anomalies": true,
    "anoValue": true,
    "anoZ": 3,
    "anoValueMinutes": 30,
    "anoRare": true,
    "anoRareShare": 2,
    "anoSilent": true,
    "anoSilentHours": 6,
    "anoLong": true,
    "anoLongFactor": 1.5,
    "anoCold": true,
    "anoColdTemp": 5,
    "anoColdMinutes": 30,
    "anoOutdoor": "",
    "anoRacing": true,
    "anoRacingFactor": 10,
    "anoNotify": true,
    "anoInstance": "",
    "anoQuietHours": 12,
    "anoLearnDays": 14
  },
  "objects": [],
  "instanceObjects": [
    {
      "_id": "info",
      "type": "channel",
      "common": {
        "name": "Information"
      },
      "native": {}
    },
    {
      "_id": "info.recordedCount",
      "type": "state",
      "common": {
        "role": "value",
        "name": "Number of recorded states",
        "type": "number",
        "read": true,
        "write": false,
        "def": 0
      },
      "native": {}
    },
    {
      "_id": "info.dbSize",
      "type": "state",
      "common": {
        "role": "value",
        "name": "Size of all database files",
        "type": "number",
        "unit": "MB",
        "read": true,
        "write": false,
        "def": 0
      },
      "native": {}
    },
    {
      "_id": "info.eventsToday",
      "type": "state",
      "common": {
        "role": "value",
        "name": "Events recorded since midnight",
        "type": "number",
        "read": true,
        "write": false,
        "def": 0
      },
      "native": {}
    },
    {
      "_id": "replay",
      "type": "channel",
      "common": {
        "name": "Replay"
      },
      "native": {}
    },
    {
      "_id": "replay.active",
      "type": "state",
      "common": {
        "role": "switch",
        "name": "Replay is running",
        "type": "boolean",
        "read": true,
        "write": true,
        "def": false
      },
      "native": {}
    },
    {
      "_id": "replay.time",
      "type": "state",
      "common": {
        "role": "date",
        "name": "Replay time (writable to jump)",
        "type": "number",
        "read": true,
        "write": true,
        "def": 0
      },
      "native": {}
    },
    {
      "_id": "replay.speed",
      "type": "state",
      "common": {
        "role": "level",
        "name": "Replay speed (factor of real time)",
        "type": "number",
        "read": true,
        "write": true,
        "min": 0.1,
        "max": 3600,
        "def": 60,
        "states": {
          "1": "1x",
          "10": "10x",
          "60": "60x",
          "600": "600x"
        }
      },
      "native": {}
    },
    {
      "_id": "simulation",
      "type": "channel",
      "common": {
        "name": "Presence simulation"
      },
      "native": {}
    },
    {
      "_id": "simulation.enabled",
      "type": "state",
      "common": {
        "role": "switch",
        "name": "Presence simulation is running (switched manually or by the trigger)",
        "type": "boolean",
        "read": true,
        "write": true,
        "def": false
      },
      "native": {}
    },
    {
      "_id": "simulation.sourceDay",
      "type": "state",
      "common": {
        "role": "text",
        "name": "Recorded day that is played",
        "type": "string",
        "read": true,
        "write": false,
        "def": ""
      },
      "native": {}
    },
    {
      "_id": "simulation.nextAction",
      "type": "state",
      "common": {
        "role": "text",
        "name": "Next planned switching",
        "type": "string",
        "read": true,
        "write": false,
        "def": ""
      },
      "native": {}
    },
    {
      "_id": "simulation.lastAction",
      "type": "state",
      "common": {
        "role": "text",
        "name": "Last switching of the simulation",
        "type": "string",
        "read": true,
        "write": false,
        "def": ""
      },
      "native": {}
    },
    {
      "_id": "anomaly",
      "type": "channel",
      "common": {
        "name": "Anomaly detection"
      },
      "native": {}
    },
    {
      "_id": "anomaly.active",
      "type": "state",
      "common": {
        "role": "indicator.alarm",
        "name": "At least one open anomaly",
        "type": "boolean",
        "read": true,
        "write": false,
        "def": false
      },
      "native": {}
    },
    {
      "_id": "anomaly.count",
      "type": "state",
      "common": {
        "role": "value",
        "name": "Number of open anomalies",
        "type": "number",
        "read": true,
        "write": false,
        "def": 0
      },
      "native": {}
    },
    {
      "_id": "anomaly.list",
      "type": "state",
      "common": {
        "role": "json",
        "name": "Open anomalies (JSON)",
        "type": "string",
        "read": true,
        "write": false,
        "def": "[]"
      },
      "native": {}
    },
    {
      "_id": "anomaly.last",
      "type": "state",
      "common": {
        "role": "text",
        "name": "Newest open anomaly",
        "type": "string",
        "read": true,
        "write": false,
        "def": ""
      },
      "native": {}
    },
    {
      "_id": "anomaly.ack",
      "type": "state",
      "common": {
        "role": "button",
        "name": "Acknowledge all open anomalies",
        "type": "boolean",
        "read": false,
        "write": true,
        "def": false
      },
      "native": {}
    }
  ],
  "notifications": [
    {
      "scope": "recorder",
      "name": {
        "en": "Recorder",
        "de": "Recorder",
        "ru": "Рекордер",
        "pt": "Gravador",
        "nl": "Recorder",
        "fr": "Enregistreur",
        "it": "Registratore",
        "es": "Grabador",
        "pl": "Rejestrator",
        "uk": "Рекордер",
        "zh-cn": "记录器"
      },
      "description": {
        "en": "Messages of the recorder",
        "de": "Meldungen des Recorders",
        "ru": "Сообщения рекордера",
        "pt": "Mensagens do gravador",
        "nl": "Meldingen van de recorder",
        "fr": "Messages de l'enregistreur",
        "it": "Messaggi del registratore",
        "es": "Mensajes del grabador",
        "pl": "Komunikaty rejestratora",
        "uk": "Повідомлення рекордера",
        "zh-cn": "记录器消息"
      },
      "categories": [
        {
          "category": "anomaly",
          "name": {
            "en": "Anomaly detected",
            "de": "Anomalie erkannt",
            "ru": "Обнаружена аномалия",
            "pt": "Anomalia detetada",
            "nl": "Anomalie gedetecteerd",
            "fr": "Anomalie détectée",
            "it": "Anomalia rilevata",
            "es": "Anomalía detectada",
            "pl": "Wykryto anomalię",
            "uk": "Виявлено аномалію",
            "zh-cn": "检测到异常"
          },
          "description": {
            "en": "A value or an activity does not fit the usual weekly pattern: an open window in the cold, a silent sensor, a door at night ...",
            "de": "Ein Wert oder eine Aktivität passt nicht zum üblichen Wochenmuster: ein offenes Fenster bei Kälte, ein stiller Sensor, eine Tür in der Nacht ...",
            "ru": "Значение или активность не соответствует обычному недельному шаблону: открытое окно в холод, молчащий датчик, дверь ночью ...",
            "pt": "Um valor ou uma atividade não corresponde ao padrão semanal habitual: uma janela aberta com frio, um sensor silencioso, uma porta à noite ...",
            "nl": "Een waarde of activiteit past niet bij het gebruikelijke weekpatroon: een open raam bij kou, een stille sensor, een deur 's nachts ...",
            "fr": "Une valeur ou une activité ne correspond pas au modèle hebdomadaire habituel : une fenêtre ouverte par temps froid, un capteur muet, une porte la nuit ...",
            "it": "Un valore o un'attività non corrisponde al consueto schema settimanale: una finestra aperta al freddo, un sensore silenzioso, una porta di notte ...",
            "es": "Un valor o una actividad no encaja con el patrón semanal habitual: una ventana abierta con frío, un sensor silencioso, una puerta de noche ...",
            "pl": "Wartość lub aktywność nie pasuje do zwykłego tygodniowego wzorca: otwarte okno w zimnie, milczący czujnik, drzwi w nocy ...",
            "uk": "Значення або активність не відповідає звичному тижневому шаблону: відчинене вікно в холод, мовчазний датчик, двері вночі ...",
            "zh-cn": "某个值或活动与通常的每周模式不符：寒冷时窗户打开、传感器无响应、夜间开门……"
          },
          "severity": "notify",
          "regex": [],
          "limit": 20
        }
      ]
    }
  ]
}
