{
  "name": "iobroker.recorder",
  "version": "0.1.1",
  "description": "Records all relevant states of ioBroker without per-state configuration and provides time travel, presence simulation and anomaly detection",
  "author": "bluefox <dogafox@gmail.com>",
  "contributors": [
    "bluefox <dogafox@gmail.com>"
  ],
  "homepage": "https://github.com/ioBroker/ioBroker.recorder",
  "keywords": [
    "ioBroker",
    "recorder",
    "history",
    "time machine",
    "presence simulation",
    "anomaly detection",
    "home automation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ioBroker/ioBroker.recorder.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "@iobroker/aggregate": "^1.1.0",
    "@iobroker/type-detector": "^6.2.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/build-tools": "^3.0.3",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.2.2",
    "@iobroker/types": "^7.2.3",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "bugs": {
    "url": "https://github.com/ioBroker/ioBroker.recorder/issues"
  },
  "main": "build/main.js",
  "scripts": {
    "build": "npm run build-backend && tsx tasks.ts",
    "build-backend": "tsc -p tsconfig.build.json",
    "build-tab": "tsx tasks.ts",
    "watch": "tsc -p tsconfig.build.json --watch",
    "check": "tsc -p tsconfig.json --noEmit",
    "check-tab": "tsc -p src-tab/tsconfig.json",
    "lint": "eslint -c eslint.config.mjs",
    "lint-tab": "cd src-tab && eslint -c eslint.config.mjs src",
    "0-clean": "tsx tasks.ts --0-clean",
    "1-npm": "tsx tasks.ts --1-npm",
    "2-build": "tsx tasks.ts --2-build",
    "3-copy": "tsx tasks.ts --3-copy",
    "test:package": "mocha test/packageFiles --exit",
    "test:unit": "mocha test/unit --timeout 20000 --exit",
    "test:integration": "mocha test/integrationAdapter --exit",
    "test": "npm run test:package && npm run test:unit",
    "bench": "node test/bench/load.js",
    "translate": "translate-adapter -b admin/i18n/en.json",
    "release": "release-script --noPush -y",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes",
    "update-packages": "npx npm-check-updates --upgrade"
  },
  "files": [
    "build/",
    "admin/",
    "io-package.json",
    "LICENSE"
  ],
  "license": "MIT"
}
