{
    "i18n": true,
    "type": "tabs",
    "items": {
        "_recording": {
            "type": "panel",
            "label": "Recording",
            "items": {
                "_logo": {
                    "type": "staticImage",
                    "src": "recorder.svg",
                    "style": {
                        "width": 64,
                        "height": 64
                    },
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_categoriesHeader": {
                    "type": "header",
                    "text": "Categories",
                    "size": 4,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "catLight": {
                    "type": "select",
                    "label": "Light",
                    "options": [
                        {
                            "value": "off",
                            "label": "Off"
                        },
                        {
                            "value": "on",
                            "label": "Record"
                        },
                        {
                            "value": "aggregated",
                            "label": "Aggregate (5 min)"
                        }
                    ],
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "catShading": {
                    "type": "select",
                    "label": "Shading",
                    "options": [
                        {
                            "value": "off",
                            "label": "Off"
                        },
                        {
                            "value": "on",
                            "label": "Record"
                        },
                        {
                            "value": "aggregated",
                            "label": "Aggregate (5 min)"
                        }
                    ],
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "catClimate": {
                    "type": "select",
                    "label": "Heating and climate",
                    "options": [
                        {
                            "value": "off",
                            "label": "Off"
                        },
                        {
                            "value": "on",
                            "label": "Record"
                        },
                        {
                            "value": "aggregated",
                            "label": "Aggregate (5 min)"
                        }
                    ],
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "catWindows": {
                    "type": "select",
                    "label": "Windows and doors",
                    "options": [
                        {
                            "value": "off",
                            "label": "Off"
                        },
                        {
                            "value": "on",
                            "label": "Record"
                        },
                        {
                            "value": "aggregated",
                            "label": "Aggregate (5 min)"
                        }
                    ],
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "catMotion": {
                    "type": "select",
                    "label": "Motion and presence",
                    "help": "Motion and presence data show when somebody is at home. Off by default.",
                    "options": [
                        {
                            "value": "off",
                            "label": "Off"
                        },
                        {
                            "value": "on",
                            "label": "Record"
                        },
                        {
                            "value": "aggregated",
                            "label": "Aggregate (5 min)"
                        }
                    ],
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "catSecurity": {
                    "type": "select",
                    "label": "Security",
                    "options": [
                        {
                            "value": "off",
                            "label": "Off"
                        },
                        {
                            "value": "on",
                            "label": "Record"
                        },
                        {
                            "value": "aggregated",
                            "label": "Aggregate (5 min)"
                        }
                    ],
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "catSockets": {
                    "type": "select",
                    "label": "Switches and sockets",
                    "options": [
                        {
                            "value": "off",
                            "label": "Off"
                        },
                        {
                            "value": "on",
                            "label": "Record"
                        },
                        {
                            "value": "aggregated",
                            "label": "Aggregate (5 min)"
                        }
                    ],
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "catMedia": {
                    "type": "select",
                    "label": "Media",
                    "options": [
                        {
                            "value": "off",
                            "label": "Off"
                        },
                        {
                            "value": "on",
                            "label": "Record"
                        },
                        {
                            "value": "aggregated",
                            "label": "Aggregate (5 min)"
                        }
                    ],
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "catWeather": {
                    "type": "select",
                    "label": "Weather",
                    "options": [
                        {
                            "value": "off",
                            "label": "Off"
                        },
                        {
                            "value": "on",
                            "label": "Record"
                        },
                        {
                            "value": "aggregated",
                            "label": "Aggregate (5 min)"
                        }
                    ],
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "catEnergy": {
                    "type": "select",
                    "label": "Energy",
                    "options": [
                        {
                            "value": "off",
                            "label": "Off"
                        },
                        {
                            "value": "on",
                            "label": "Record"
                        },
                        {
                            "value": "aggregated",
                            "label": "Aggregate (5 min)"
                        }
                    ],
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "requireEnum": {
                    "type": "checkbox",
                    "label": "Only states in a room or function",
                    "help": "Automatically selected states must belong to a room or function (directly or by their channel or device). Include rules and per-state settings are not affected.",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_storageHeader": {
                    "type": "header",
                    "text": "Storage",
                    "size": 4,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "retentionDays": {
                    "type": "select",
                    "label": "Keep raw data",
                    "help": "Events and keyframes older than this are deleted daily at 03:30",
                    "options": [
                        {
                            "value": 1,
                            "label": "1 day"
                        },
                        {
                            "value": 7,
                            "label": "7 days"
                        },
                        {
                            "value": 30,
                            "label": "30 days"
                        },
                        {
                            "value": 90,
                            "label": "90 days"
                        }
                    ],
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "flushInterval": {
                    "type": "number",
                    "label": "Write interval",
                    "help": "Changes are collected in memory and written in one transaction. Longer intervals spare SD cards.",
                    "unit": "sec",
                    "min": 1,
                    "max": 600,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "_replayHeader": {
                    "type": "header",
                    "text": "Replay",
                    "size": 4,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "mirrorStates": {
                    "type": "checkbox",
                    "label": "Mirror states for vis",
                    "help": "Creates a read-only copy of every recorded state under mirror.*. While replay.active is on, the replay writes the past values there: a vis view on the mirrors becomes a time machine.",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 8,
                    "xl": 8
                }
            }
        },
        "_rules": {
            "type": "panel",
            "label": "Rules",
            "items": {
                "_rulesInfo": {
                    "type": "staticText",
                    "text": "Patterns with * as wildcard, e.g. zigbee.0.*.state. Include rules add states to the automatic selection, exclude rules remove them. Single states can also be set in the object browser (custom settings).",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "includePatterns": {
                    "type": "chips",
                    "label": "Include",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 6,
                    "xl": 6
                },
                "excludePatterns": {
                    "type": "chips",
                    "label": "Exclude",
                    "help": "Excluded states are never recorded, even if they match an include pattern",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 6,
                    "xl": 6
                },
                "_filterHeader": {
                    "type": "header",
                    "text": "Frequency filter",
                    "size": 5,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_filterInfo": {
                    "type": "staticText",
                    "text": "Numbers are stored when they change by at least the dead band, at most once per minimum interval (then the latest value), and changes within the dead band after the heartbeat. Defaults: temperature 0.2 / 60 s / 1 h, humidity 2 / 60 s / 1 h, brightness 10 % / 60 s / 1 h, dimmer and blind 1 / 0 s / none, power 5 % / 60 s / 15 min, other numbers 1 % / 60 s / 1 h. A rule below overrides the default of its roles; * is a wildcard (e.g. value.temperature*).",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "highRate": {
                    "type": "number",
                    "label": "Aggregate numbers above",
                    "help": "Changes per minute (average of an hour): such numbers are stored as 5 minute aggregates",
                    "min": 1,
                    "max": 600,
                    "unit": "changes/min",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "burstLimit": {
                    "type": "number",
                    "label": "Throttle above",
                    "help": "Changes per minute: protects the database from defective sensors. Other states above this average are not recorded. 0: off",
                    "min": 0,
                    "max": 6000,
                    "unit": "changes/min",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "roleRules": {
                    "type": "table",
                    "label": "Rules per role",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "items": [
                        {
                            "type": "text",
                            "attr": "role",
                            "title": "Role",
                            "width": "30%",
                            "default": ""
                        },
                        {
                            "type": "number",
                            "attr": "deadband",
                            "title": "Dead band",
                            "min": 0,
                            "default": 0
                        },
                        {
                            "type": "checkbox",
                            "attr": "relative",
                            "title": "in %",
                            "default": false
                        },
                        {
                            "type": "number",
                            "attr": "minInterval",
                            "title": "Min. interval (s)",
                            "min": 0,
                            "default": 60
                        },
                        {
                            "type": "number",
                            "attr": "heartbeat",
                            "title": "Heartbeat (min)",
                            "min": 0,
                            "default": 60
                        }
                    ]
                },
                "_recalculate": {
                    "type": "sendTo",
                    "label": "Recalculate selection",
                    "command": "recalculate",
                    "icon": "refresh",
                    "variant": "outlined",
                    "showProcess": true,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                }
            }
        },
        "_frequency": {
            "type": "panel",
            "label": "High frequency",
            "items": {
                "_frequencyTable": {
                    "type": "textSendTo",
                    "container": "html",
                    "command": "getHighFrequency",
                    "alsoDependsOn": ["highRate", "burstLimit"],
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                }
            }
        },
        "_preview": {
            "type": "panel",
            "label": "Preview",
            "items": {
                "_previewInfo": {
                    "type": "staticText",
                    "text": "The preview shows which states would be recorded with the settings above, also before saving. The instance must be running.",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_previewTable": {
                    "type": "textSendTo",
                    "container": "html",
                    "command": "previewSelection",
                    "jsonData": "{\"retentionDays\": ${Number(data.retentionDays) || 30}, \"requireEnum\": ${!!data.requireEnum}, \"catLight\": \"${data.catLight}\", \"catShading\": \"${data.catShading}\", \"catClimate\": \"${data.catClimate}\", \"catWindows\": \"${data.catWindows}\", \"catMotion\": \"${data.catMotion}\", \"catSecurity\": \"${data.catSecurity}\", \"catSockets\": \"${data.catSockets}\", \"catMedia\": \"${data.catMedia}\", \"catWeather\": \"${data.catWeather}\", \"catEnergy\": \"${data.catEnergy}\", \"includePatterns\": ${JSON.stringify(data.includePatterns || [])}, \"excludePatterns\": ${JSON.stringify(data.excludePatterns || [])}}",
                    "alsoDependsOn": [
                        "retentionDays",
                        "requireEnum",
                        "catLight",
                        "catShading",
                        "catClimate",
                        "catWindows",
                        "catMotion",
                        "catSecurity",
                        "catSockets",
                        "catMedia",
                        "catWeather",
                        "catEnergy",
                        "includePatterns",
                        "excludePatterns"
                    ],
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                }
            }
        },
        "_simulation": {
            "type": "panel",
            "label": "Presence simulation",
            "items": {
                "_simInfo": {
                    "type": "staticText",
                    "text": "While you are away, the simulation plays the switching of lights and blinds of a recorded day at home: the same weekday some weeks ago, shifted by a few minutes at random and by the sunset. Heating, locks, sockets, gates and read-only states are never switched. When you come back, it stops at once and switches off the lights it switched on.",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "simulation": {
                    "type": "checkbox",
                    "label": "Use presence simulation",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 8,
                    "xl": 8
                },
                "_triggerHeader": {
                    "type": "header",
                    "text": "Start and stop",
                    "size": 4,
                    "newLine": true,
                    "hidden": "!data.simulation && !data.anomalies",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "simTrigger": {
                    "type": "objectId",
                    "label": "Absence state",
                    "help": "Starts the simulation when it reports absence (e.g. 0_userdata.0.away or an armed alarm system) and stops it at once when it reports presence. Without a state, the simulation is switched with simulation.enabled.",
                    "newLine": true,
                    "hidden": "!data.simulation && !data.anomalies",
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 6,
                    "xl": 6
                },
                "simTriggerInvert": {
                    "type": "checkbox",
                    "label": "The state reports presence (true = at home)",
                    "newLine": true,
                    "hidden": "!data.simulation && !data.anomalies",
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 6,
                    "xl": 6
                },
                "_playHeader": {
                    "type": "header",
                    "text": "What is played",
                    "size": 4,
                    "newLine": true,
                    "hidden": "!data.simulation",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "simWeeks": {
                    "type": "number",
                    "label": "Weeks back",
                    "help": "The same weekday 1 to N weeks ago is chosen at random; if none was at home, another day",
                    "min": 1,
                    "max": 12,
                    "newLine": true,
                    "hidden": "!data.simulation",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "simJitter": {
                    "type": "number",
                    "label": "Random shift",
                    "help": "Each group of switchings is shifted by up to this many minutes earlier or later",
                    "min": 0,
                    "max": 60,
                    "unit": "min",
                    "hidden": "!data.simulation",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "simSunset": {
                    "type": "checkbox",
                    "label": "Follow the sunset",
                    "help": "Afternoon and evening are shifted by the difference of the sunsets (coordinates from the system settings)",
                    "newLine": true,
                    "hidden": "!data.simulation",
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 6,
                    "xl": 6
                },
                "simMedia": {
                    "type": "checkbox",
                    "label": "Also switch media on and off",
                    "newLine": true,
                    "hidden": "!data.simulation",
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 6,
                    "xl": 6
                },
                "simScripts": {
                    "type": "checkbox",
                    "label": "Also play the switching of scripts",
                    "help": "Normally only the switching of persons is played (user interfaces, apps, switches on the wall), because scripts keep running anyway",
                    "newLine": true,
                    "hidden": "!data.simulation",
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 6,
                    "xl": 6
                },
                "simDryRun": {
                    "type": "checkbox",
                    "label": "Only log, switch nothing (test)",
                    "newLine": true,
                    "hidden": "!data.simulation",
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 6,
                    "xl": 6
                },
                "_planHeader": {
                    "type": "header",
                    "text": "Plan for today",
                    "size": 4,
                    "newLine": true,
                    "hidden": "!data.simulation",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_simPlan": {
                    "type": "textSendTo",
                    "container": "html",
                    "command": "getSimulationPlan",
                    "jsonData": "{\"simWeeks\": ${Number(data.simWeeks) || 4}, \"simJitter\": ${Number(data.simJitter) || 0}, \"simSunset\": ${!!data.simSunset}, \"simMedia\": ${!!data.simMedia}, \"simScripts\": ${!!data.simScripts}}",
                    "alsoDependsOn": ["simWeeks", "simJitter", "simSunset", "simMedia", "simScripts"],
                    "hidden": "!data.simulation",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                }
            }
        },
        "_anomalies": {
            "type": "panel",
            "label": "Anomalies",
            "items": {
                "_anoInfo": {
                    "type": "staticText",
                    "text": "The detection learns for every recorded datapoint what is usual in each hour of the week and reports what does not fit: an open window in the cold, a silent sensor, the front door at 3 am. The statistics are collected all the time; the rules that need a profile start after the learning period.",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "anomalies": {
                    "type": "checkbox",
                    "label": "Detect anomalies",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 6,
                    "xl": 6
                },
                "_rulesHeader": {
                    "type": "header",
                    "text": "Rules",
                    "size": 4,
                    "newLine": true,
                    "hidden": "!data.anomalies",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "anoValue": {
                    "type": "checkbox",
                    "label": "Unusual values",
                    "help": "A temperature, a power ... far from what is usual in this hour of the week (z-score) and outside of everything seen at this time",
                    "newLine": true,
                    "hidden": "!data.anomalies",
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 6,
                    "xl": 6
                },
                "anoZ": {
                    "type": "number",
                    "label": "Z-score",
                    "min": 1.5,
                    "max": 10,
                    "step": 0.5,
                    "hidden": "!data.anomalies || !data.anoValue",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "anoValueMinutes": {
                    "type": "number",
                    "label": "For at least",
                    "min": 0,
                    "max": 1440,
                    "step": 5,
                    "hidden": "!data.anomalies || !data.anoValue",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3,
                    "unit": "min"
                },
                "anoRare": {
                    "type": "checkbox",
                    "label": "Rare activity",
                    "help": "A door, a window, motion or a light in an hour in which this hardly ever happens. While the absence state (tab Presence simulation) reports absence, every motion and opening is reported.",
                    "newLine": true,
                    "hidden": "!data.anomalies",
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 6,
                    "xl": 6
                },
                "anoRareShare": {
                    "type": "number",
                    "label": "Rare below",
                    "min": 0,
                    "max": 50,
                    "step": 0.5,
                    "hidden": "!data.anomalies || !data.anoRare",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3,
                    "unit": "%",
                    "help": "Share of the weeks with activity in this hour"
                },
                "anoSilent": {
                    "type": "checkbox",
                    "label": "Silent sensor",
                    "help": "No update for 4 times the usual interval",
                    "newLine": true,
                    "hidden": "!data.anomalies",
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 6,
                    "xl": 6
                },
                "anoSilentHours": {
                    "type": "number",
                    "label": "At least",
                    "min": 1,
                    "max": 168,
                    "step": 1,
                    "hidden": "!data.anomalies || !data.anoSilent",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3,
                    "unit": "h"
                },
                "anoLong": {
                    "type": "checkbox",
                    "label": "Open or on unusually long",
                    "help": "Windows, doors and lights, compared with the usual duration (95th percentile)",
                    "newLine": true,
                    "hidden": "!data.anomalies",
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 6,
                    "xl": 6
                },
                "anoLongFactor": {
                    "type": "number",
                    "label": "Times the usual duration",
                    "min": 1,
                    "max": 20,
                    "step": 0.5,
                    "hidden": "!data.anomalies || !data.anoLong",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "anoCold": {
                    "type": "checkbox",
                    "label": "Window open in the cold",
                    "newLine": true,
                    "hidden": "!data.anomalies",
                    "xs": 12,
