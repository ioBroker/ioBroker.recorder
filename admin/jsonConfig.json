{
    "i18n": true,
    "type": "tabs",
    "items": {
        "_recording": {
            "type": "panel",
            "label": "Recording",
            "items": {
                "_logo": {
                    "type": "staticImage",
                    "src": "recorder.svg",
                    "style": {
                        "width": 64,
                        "height": 64
                    },
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_categoriesHeader": {
                    "type": "header",
                    "text": "Categories",
                    "size": 4,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "catLight": {
                    "type": "select",
                    "label": "Light",
                    "options": [
                        {
                            "value": "off",
                            "label": "Off"
                        },
                        {
                            "value": "on",
                            "label": "Record"
                        },
                        {
                            "value": "aggregated",
                            "label": "Aggregate (5 min)"
                        }
                    ],
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "catShading": {
                    "type": "select",
                    "label": "Shading",
                    "options": [
                        {
                            "value": "off",
                            "label": "Off"
                        },
                        {
                            "value": "on",
                            "label": "Record"
                        },
                        {
                            "value": "aggregated",
                            "label": "Aggregate (5 min)"
                        }
                    ],
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "catClimate": {
                    "type": "select",
                    "label": "Heating and climate",
                    "options": [
                        {
                            "value": "off",
                            "label": "Off"
                        },
                        {
                            "value": "on",
                            "label": "Record"
                        },
                        {
                            "value": "aggregated",
                            "label": "Aggregate (5 min)"
                        }
                    ],
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "catWindows": {
                    "type": "select",
                    "label": "Windows and doors",
                    "options": [
                        {
                            "value": "off",
                            "label": "Off"
                        },
                        {
                            "value": "on",
                            "label": "Record"
                        },
                        {
                            "value": "aggregated",
                            "label": "Aggregate (5 min)"
                        }
                    ],
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "catMotion": {
                    "type": "select",
                    "label": "Motion and presence",
                    "help": "Motion and presence data show when somebody is at home. Off by default.",
                    "options": [
                        {
                            "value": "off",
                            "label": "Off"
                        },
                        {
                            "value": "on",
                            "label": "Record"
                        },
                        {
                            "value": "aggregated",
                            "label": "Aggregate (5 min)"
                        }
                    ],
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "catSecurity": {
                    "type": "select",
                    "label": "Security",
                    "options": [
                        {
                            "value": "off",
                            "label": "Off"
                        },
                        {
                            "value": "on",
                            "label": "Record"
                        },
                        {
                            "value": "aggregated",
                            "label": "Aggregate (5 min)"
                        }
                    ],
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "catSockets": {
                    "type": "select",
                    "label": "Switches and sockets",
                    "options": [
                        {
                            "value": "off",
                            "label": "Off"
                        },
                        {
                            "value": "on",
                            "label": "Record"
                        },
                        {
                            "value": "aggregated",
                            "label": "Aggregate (5 min)"
                        }
                    ],
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "catMedia": {
                    "type": "select",
                    "label": "Media",
                    "options": [
                        {
                            "value": "off",
                            "label": "Off"
                        },
                        {
                            "value": "on",
                            "label": "Record"
                        },
                        {
                            "value": "aggregated",
                            "label": "Aggregate (5 min)"
                        }
                    ],
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "catWeather": {
                    "type": "select",
                    "label": "Weather",
                    "options": [
                        {
                            "value": "off",
                            "label": "Off"
                        },
                        {
                            "value": "on",
                            "label": "Record"
                        },
                        {
                            "value": "aggregated",
                            "label": "Aggregate (5 min)"
                        }
                    ],
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "catEnergy": {
                    "type": "select",
                    "label": "Energy",
                    "options": [
                        {
                            "value": "off",
                            "label": "Off"
                        },
                        {
                            "value": "on",
                            "label": "Record"
                        },
                        {
                            "value": "aggregated",
                            "label": "Aggregate (5 min)"
                        }
                    ],
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "requireEnum": {
                    "type": "checkbox",
                    "label": "Only states in a room or function",
                    "help": "Automatically selected states must belong to a room or function (directly or by their channel or device). Include rules and per-state settings are not affected.",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_storageHeader": {
                    "type": "header",
                    "text": "Storage",
                    "size": 4,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "retentionDays": {
                    "type": "select",
                    "label": "Keep raw data",
                    "help": "Events and keyframes older than this are deleted daily at 03:30",
                    "options": [
                        {
                            "value": 1,
                            "label": "1 day"
                        },
                        {
                            "value": 7,
                            "label": "7 days"
                        },
                        {
                            "value": 30,
                            "label": "30 days"
                        },
                        {
                            "value": 90,
                            "label": "90 days"
                        }
                    ],
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "flushInterval": {
                    "type": "number",
                    "label": "Write interval",
                    "help": "Changes are collected in memory and written in one transaction. Longer intervals spare SD cards.",
                    "unit": "sec",
                    "min": 1,
                    "max": 600,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                }
            }
        },
        "_rules": {
            "type": "panel",
            "label": "Rules",
            "items": {
                "_rulesInfo": {
                    "type": "staticText",
                    "text": "Patterns with * as wildcard, e.g. zigbee.0.*.state. Include rules add states to the automatic selection, exclude rules remove them. Single states can also be set in the object browser (custom settings).",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "includePatterns": {
                    "type": "chips",
                    "label": "Include",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 6,
                    "xl": 6
                },
                "excludePatterns": {
                    "type": "chips",
                    "label": "Exclude",
                    "help": "Excluded states are never recorded, even if they match an include pattern",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 6,
                    "xl": 6
                },
                "_filterHeader": {
                    "type": "header",
                    "text": "Frequency filter",
                    "size": 5,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_filterInfo": {
                    "type": "staticText",
                    "text": "Numbers are stored when they change by at least the dead band, at most once per minimum interval (then the latest value), and changes within the dead band after the heartbeat. Defaults: temperature 0.2 / 60 s / 1 h, humidity 2 / 60 s / 1 h, brightness 10 % / 60 s / 1 h, dimmer and blind 1 / 0 s / none, power 5 % / 60 s / 15 min, other numbers 1 % / 60 s / 1 h. A rule below overrides the default of its roles; * is a wildcard (e.g. value.temperature*).",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "highRate": {
                    "type": "number",
                    "label": "Aggregate numbers above",
                    "help": "Changes per minute (average of an hour): such numbers are stored as 5 minute aggregates",
                    "min": 1,
                    "max": 600,
                    "unit": "changes/min",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "burstLimit": {
                    "type": "number",
                    "label": "Throttle above",
                    "help": "Changes per minute: protects the database from defective sensors. Other states above this average are not recorded. 0: off",
                    "min": 0,
                    "max": 6000,
                    "unit": "changes/min",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "roleRules": {
                    "type": "table",
                    "label": "Rules per role",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "items": [
                        {
                            "type": "text",
                            "attr": "role",
                            "title": "Role",
                            "width": "30%",
                            "default": ""
                        },
                        {
                            "type": "number",
                            "attr": "deadband",
                            "title": "Dead band",
                            "min": 0,
                            "default": 0
                        },
                        {
                            "type": "checkbox",
                            "attr": "relative",
                            "title": "in %",
                            "default": false
                        },
                        {
                            "type": "number",
                            "attr": "minInterval",
                            "title": "Min. interval (s)",
                            "min": 0,
                            "default": 60
                        },
                        {
                            "type": "number",
                            "attr": "heartbeat",
                            "title": "Heartbeat (min)",
                            "min": 0,
                            "default": 60
                        }
                    ]
                },
                "_recalculate": {
                    "type": "sendTo",
                    "label": "Recalculate selection",
                    "command": "recalculate",
                    "icon": "refresh",
                    "variant": "outlined",
                    "showProcess": true,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                }
            }
        },
        "_frequency": {
            "type": "panel",
            "label": "High frequency",
            "items": {
                "_frequencyTable": {
                    "type": "textSendTo",
                    "container": "html",
                    "command": "getHighFrequency",
                    "alsoDependsOn": ["highRate", "burstLimit"],
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                }
            }
        },
        "_preview": {
            "type": "panel",
            "label": "Preview",
            "items": {
                "_previewInfo": {
                    "type": "staticText",
                    "text": "The preview shows which states would be recorded with the settings above, also before saving. The instance must be running.",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_previewTable": {
                    "type": "textSendTo",
                    "container": "html",
                    "command": "previewSelection",
                    "jsonData": "{\"retentionDays\": ${Number(data.retentionDays) || 30}, \"requireEnum\": ${!!data.requireEnum}, \"catLight\": \"${data.catLight}\", \"catShading\": \"${data.catShading}\", \"catClimate\": \"${data.catClimate}\", \"catWindows\": \"${data.catWindows}\", \"catMotion\": \"${data.catMotion}\", \"catSecurity\": \"${data.catSecurity}\", \"catSockets\": \"${data.catSockets}\", \"catMedia\": \"${data.catMedia}\", \"catWeather\": \"${data.catWeather}\", \"catEnergy\": \"${data.catEnergy}\", \"includePatterns\": ${JSON.stringify(data.includePatterns || [])}, \"excludePatterns\": ${JSON.stringify(data.excludePatterns || [])}}",
                    "alsoDependsOn": [
                        "retentionDays",
                        "requireEnum",
                        "catLight",
                        "catShading",
                        "catClimate",
                        "catWindows",
                        "catMotion",
                        "catSecurity",
                        "catSockets",
                        "catMedia",
                        "catWeather",
                        "catEnergy",
                        "includePatterns",
                        "excludePatterns"
                    ],
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                }
            }
        }
    }
}
